<?xml version="1.0" encoding="UTF-8"?>
<Context>
    <!-- Configuration de la DataSource pour JTA -->
    <Resource name="jdbc/EventManagerDS"
              auth="Container"
              type="javax.sql.DataSource"
              maxTotal="20"
              maxIdle="10"
              maxWaitMillis="10000"
              username="PLACEHOLDER_DB_USER"
              password="PLACEHOLDER_DB_PASS"
              driverClassName="com.mysql.cj.jdbc.Driver"
              url="PLACEHOLDER_JDBC_URL"
              factory="org.apache.tomcat.jdbc.pool.DataSourceFactory"/>
    
    <!-- Configuration du gestionnaire de transactions -->
    <Transaction factory="org.apache.catalina.UserTransaction"/>
</Context>
